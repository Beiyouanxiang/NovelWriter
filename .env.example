# ============================================================
# NovelWriter 服务端环境变量示例
# 复制本文件为 .env.local 并填入真实值（.env.local 已加入 .gitignore）
#
# API Key 只能保存在服务端环境变量中，绝不进入前端、localStorage、日志或响应。
# ============================================================

# ---------- DeepSeek ----------
# DeepSeek API Key（必填，否则 deepseek provider 不可用）
DEEPSEEK_API_KEY=
# 模型 ID 从环境变量读取，不要在前端/代码里写死模型名称
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 可选模型列表（逗号分隔，用于界面下拉；默认用 DEEPSEEK_MODEL）
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# ---------- Kimi（Moonshot） ----------
# Kimi API Key（必填，否则 kimi provider 不可用）
KIMI_API_KEY=
# Kimi 模型 ID（例如 moonshot-v1-8k / moonshot-v1-32k / kimi-latest 等，以官方为准）
KIMI_MODEL=moonshot-v1-8k
# Kimi OpenAI 兼容接口地址
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Kimi 可选模型列表（逗号分隔，用于界面下拉）
KIMI_MODELS=moonshot-v1-8k,moonshot-v1-32k,moonshot-v1-128k

# ---------- GLM（智谱） ----------
# 智谱 API Key（必填，否则 glm provider 不可用）
GLM_API_KEY=
# GLM 模型 ID（例如 glm-4-flash / glm-4-plus / glm-4.5 等，以官方为准）
GLM_MODEL=glm-4-flash
# 智谱 OpenAI 兼容接口地址
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM 可选模型列表（逗号分隔，用于界面下拉）
GLM_MODELS=glm-4-flash,glm-4-plus,glm-4.5

# ---------- LLM 通用 ----------
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=30000
# 允许的 provider 列表（逗号分隔）
LLM_ALLOWED_PROVIDERS=deepseek,kimi,glm

# ---------- Runtime 选择 ----------
# direct：直接调用 DeepSeek / Kimi 的 OpenAI 兼容接口（当前版本）
# harness：走 DeepSeek Harness（尚未接入，选择后会返回清晰错误，详见 HARNESS_INTEGRATION.md）
NOVEL_RUNTIME=direct

# ---------- 访问控制与限流 ----------
# 可选：服务端访问口令。设置后前端需在「作品设定 → 服务端访问口令」填入相同值，
# 否则 /api/chat 返回 401。留空则不做口令校验（但仍会限流）。
NOVEL_ACCESS_TOKEN=
# 可信代理头：默认空 = 不信任任何客户端头，所有请求按 "unknown" 计（无法伪造绕过）。
# 仅当服务位于受信 Nginx 之后、且 Nginx 以「覆盖」方式写 X-Real-IP 时才设为 x-real-ip。
TRUSTED_IP_HEADER=
# 限流（内存级，单实例生效）。设为 1 可关闭限流。
NOVEL_RATE_LIMIT_DISABLED=
# 单 IP 每分钟 / 每日请求额度
NOVEL_RATE_IP_PER_MINUTE=30
NOVEL_RATE_IP_PER_DAY=300
# 全局每分钟 / 每日请求额度
NOVEL_RATE_GLOBAL_PER_MINUTE=120
NOVEL_RATE_GLOBAL_PER_DAY=5000
# IP 窗口最大条目数（防伪造 IP 导致内存耗尽，默认 10000）
NOVEL_RATE_MAX_IP_ENTRIES=10000

# ---------- 数据库与认证 ----------
# PostgreSQL 连接串（账号/数据库/协作数据落库）
DATABASE_URL=postgresql://novelwriter:novelwriter@localhost:5432/novelwriter
# 会话签名密钥（至少 32 字节随机串；生产必填，否则拒绝启动）
# 生成示例：openssl rand -hex 32
JWT_SECRET=




# ============================================================
# NovelWriter 服务端环境变量示例
# 复制本文件为 .env.local 并填入真实值（.env.local 已加入 .gitignore）
#
# API Key 只能保存在服务端环境变量中，绝不进入前端、localStorage、日志或响应。
# ============================================================

# ---------- DeepSeek ----------
# DeepSeek API Key（必填，否则 deepseek provider 不可用）
DEEPSEEK_API_KEY=
# 模型 ID 从环境变量读取，不要在前端/代码里写死模型名称
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- Kimi（Moonshot） ----------
# Kimi API Key（必填，否则 kimi provider 不可用）
KIMI_API_KEY=
# Kimi 模型 ID（例如 moonshot-v1-8k / moonshot-v1-32k / kimi-latest 等，以官方为准）
KIMI_MODEL=moonshot-v1-8k
# Kimi OpenAI 兼容接口地址
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ---------- LLM 通用 ----------
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=30000
# 允许的 provider 列表（逗号分隔）
LLM_ALLOWED_PROVIDERS=deepseek,kimi

# ---------- Runtime 选择 ----------
# direct：直接调用 DeepSeek / Kimi 的 OpenAI 兼容接口（当前版本）
# harness：走 DeepSeek Harness（尚未接入，选择后会返回清晰错误，详见 HARNESS_INTEGRATION.md）
NOVEL_RUNTIME=direct
